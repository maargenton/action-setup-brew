{
    "name": "action-setup-brew",
    "version": "1.0.0",
    "description": "GitHub Action to set up Homebrew/Linuxbrew with caching",
    "main": "dist/index.js",
    "scripts": {
        "build": "npm run build:main && npm run build:post",
        "build:main": "ncc build src/index.js -o dist --minify",
        "build:post": "ncc build src/post.js -o dist/post --minify",
        "package": "npm run build",
        "lint": "eslint src/**/*.js",
        "format": "prettier --write src/**/*.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/maargenton/action-setup-brew.git"
    },
    "keywords": [
        "actions",
        "node",
        "setup",
        "homebrew",
        "linuxbrew",
        "brew",
        "cache"
    ],
    "author": "maargenton",
    "license": "MIT",
    "dependencies": {
        "@actions/core": "^1.10.1",
        "@actions/cache": "^3.2.4",
        "@actions/exec": "^1.1.1",
        "@actions/io": "^1.1.3",
        "@actions/tool-cache": "^2.0.1"
    },
    "devDependencies": {
        "@vercel/ncc": "^0.38.1",
        "eslint": "^8.57.0",
        "prettier": "^3.2.5"
    }
}
